FROM node:22-bookworm-slim AS research-node-deps
WORKDIR /workspace
COPY package.json package-lock.json .npmrc ./
RUN npm ci

FROM node:22-bookworm-slim AS research-runtime
ENV DEBIAN_FRONTEND=noninteractive
ENV NEXT_TELEMETRY_DISABLED=1
ENV PATH="/opt/dao-sim-venv/bin:${PATH}"
WORKDIR /workspace

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      ca-certificates \
      git \
      latexmk \
      python3 \
      python3-pip \
      python3-venv \
      texlive-bibtex-extra \
      texlive-fonts-recommended \
      texlive-latex-base \
      texlive-latex-extra \
      texlive-latex-recommended \
      texlive-pictures \
      texlive-science \
    && rm -rf /var/lib/apt/lists/*

COPY python/requirements-research.txt /tmp/requirements-research.txt
RUN python3 -m venv /opt/dao-sim-venv \
    && pip install --no-cache-dir --requirement /tmp/requirements-research.txt

COPY --from=research-node-deps /workspace/node_modules ./node_modules
COPY . .

CMD ["npm", "run", "reproduce", "--", "--help"]
